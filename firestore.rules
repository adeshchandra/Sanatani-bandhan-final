rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Function: ensures request.auth.uid is not null
    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSuperAdmin() {
      return isLoggedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    // 2. Tenant Isolation Function: ensures token.workspaceId matches requested tenantId
    function isSameTenant(tenantId) {
      return isLoggedIn() && request.auth.token.workspaceId == tenantId;
    }

    // 3. Users Collection: Users can read and update their own profile
    match /users/{userId} {
      allow read: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && request.auth.uid == userId;
      allow create: if isLoggedIn() && request.auth.uid == userId;
    }

    // 4. Multi-Tenant Partition Collection with Super Admin God Mode
    match /tenants/{tenantId} {
      allow read, write: if isSameTenant(tenantId) || isSuperAdmin();
      
      match /treasury/{docId} { allow read, write: if isSameTenant(tenantId) || isSuperAdmin(); }
      match /devotees/{docId} { allow read, write: if isSameTenant(tenantId) || isSuperAdmin(); }
      match /yatranet_alerts/{docId} { allow read, write: if isSameTenant(tenantId) || isSuperAdmin(); }
    }

    match /platform_admins/{adminId} {
      allow read: if isLoggedIn() && request.auth.uid == adminId;
    }
  }
}
