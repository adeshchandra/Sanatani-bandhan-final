rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE AUTH & ROLE HELPER FUNCTIONS
    // =========================================================================
    
    function isAuthenticated() { return request.auth != null; }
    function isGlobalAdmin() { return isAuthenticated() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)); }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function belongsToWorkspace(workspaceId) {
      return isAuthenticated() && (
        getUserData().workspaceId == workspaceId || 
        workspaceId == 'PUROHIT_' + request.auth.uid
      );
    }
    function hasWorkspaceRole(workspaceId, allowedRoles) {
      return belongsToWorkspace(workspaceId) && (getUserData().role in allowedRoles);
    }
    function isBlocked() {
      return exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid));
    }

    // =========================================================================
    // 2. GLOBAL & SYSTEM NODES
    // =========================================================================
    match /platform_leads/{leadId} { allow create: if true; allow read, update, delete: if isGlobalAdmin(); }
    match /app_config/{configId} { allow read: if isAuthenticated(); allow write: if isGlobalAdmin(); }
    match /global_purohits/{purohitId} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && request.auth.uid == purohitId; }
    match /upgrade_requests/{reqId} { allow create: if isAuthenticated(); allow read, update, delete: if isGlobalAdmin(); }

    // GLOBAL SOCIAL & SUPPORT
    match /yatra_broadcasts/{bId} { allow read, create: if isAuthenticated(); allow update, delete: if isGlobalAdmin(); }
    match /global_support_threads/{tId} { allow read, create: if isAuthenticated(); allow update, delete: if isGlobalAdmin(); }
    match /global_support_replies/{rId} { allow read, create: if isAuthenticated(); allow update, delete: if isGlobalAdmin(); }
    match /chats/{chatId}/{document=**} { allow read, write: if isAuthenticated(); }
    match /polls/{pollId} { allow read: if isAuthenticated(); allow write: if isGlobalAdmin() || getUserData().role in ['SUPER_ADMIN', 'MANAGER']; }
    match /check_ins/{docId} { allow read, write: if isAuthenticated(); }

    // =========================================================================
    // 3. TOP-LEVEL CRM & FINANCIALS
    // =========================================================================
    match /users/{userId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.uid == userId && !isBlocked());
      allow write: if isGlobalAdmin() || (
        isAuthenticated() && request.auth.uid == userId && !isBlocked()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'workspaceId']) || resource == null)
      );
    }

    match /workspaces/{workspaceId} {
      allow read: if isGlobalAdmin() || belongsToWorkspace(workspaceId);
      allow write: if isGlobalAdmin() || hasWorkspaceRole(workspaceId, ['SUPER_ADMIN', 'ADMIN']);
    }

    match /treasury/{docId} {
      allow read: if isAuthenticated() && getUserData().role in ['SUPER_ADMIN', 'MANAGER', 'ACCOUNTANT'];
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getUserData().role in ['SUPER_ADMIN', 'MANAGER', 'ACCOUNTANT'];
      allow delete: if false; 
    }

    match /devotees/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserData().role in ['SUPER_ADMIN', 'MANAGER', 'ACCOUNTANT', 'PUROHIT', 'VOLUNTEER'];
    }

    match /pooja_bookings/{docId} { allow read, write: if isAuthenticated(); }
    match /pitru_records/{docId} { allow read, write: if isAuthenticated(); }
    match /festivals/{docId} { allow read, write: if isAuthenticated(); }
    match /audit_logs/{docId} { allow create, read: if isAuthenticated(); allow update, delete: if false; }

    // =========================================================================
    // 4. MULTI-TENANT WORKSPACE SUBCOLLECTIONS (Communities)
    // =========================================================================
    match /communities/{communityId}/{collectionName}/{docId} {
      // Allow read if user belongs to this community
      allow read: if isGlobalAdmin() || belongsToWorkspace(communityId);
      
      // Strict write controls per collection
      allow write: if isGlobalAdmin() || (belongsToWorkspace(communityId) && (
        collectionName in ['vivah_profiles', 'vivah_connections', 'sadhana_logs', 'social_feed', 'yatra_social_feed', 'purohit_gigs', 'purohit_applications']
        || getUserData().role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'PUROHIT']
      ));
    }

    // =========================================================================
    // 5. DEFAULT FALLBACK
    // =========================================================================
    match /{document=**} {
      allow read, write: if isGlobalAdmin();
    }
  }
}
