rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is signed in with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow anyone to read the basic workspace config, but only authenticated users to write
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /polls/{pollId} {
      allow read: if true;
      allow write: if true; // Just for ease of preview environment if they're voting without full auth yet
    }
    
    // All other collections require the user to be logged in
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
