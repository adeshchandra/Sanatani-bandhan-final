rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSuperAdmin() {
      return isLoggedIn() && (
        request.auth.token.email == 'poranray7744@gmail.com' ||
        exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid))
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // 2. Tenants Partition Collection & Subcollections
    match /tenants/{tenantId} {
      // Allow reading tenant metadata for public discovery, landing page, and admin dashboard
      allow read: if true;
      allow write: if isSuperAdmin() || isLoggedIn();
      
      match /treasury/{docId} { 
        allow read: if true;
        allow write: if isLoggedIn() || isSuperAdmin();
      }
      
      match /devotees/{docId} { 
        allow read: if true;
        allow write: if isLoggedIn() || isSuperAdmin();
      }
      
      match /yatranet_alerts/{docId} { 
        allow read: if true;
        allow write: if isLoggedIn() || isSuperAdmin();
      }

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isLoggedIn() || isSuperAdmin();
      }
    }

    // 3. Platform Admins Collection
    match /platform_admins/{adminId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // 4. Legacy / flat root collections for fallback compatibility
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if isLoggedIn() || isSuperAdmin();
    }

    match /devotees/{devoteeId} {
      allow read: if true;
      allow write: if isLoggedIn() || isSuperAdmin();
    }

    match /treasury/{treasuryId} {
      allow read: if true;
      allow write: if isLoggedIn() || isSuperAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow write: if isLoggedIn() || isSuperAdmin();
    }
  }
}
